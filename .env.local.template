# ─────────────────────────────────────────────────
# FarmForYou — environment variables (Merry Farms is the first farm)
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────

# ── Supabase (free tier) ──────────────────────────
# supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by scripts/add-staff.ts to create staff logins.
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Prisma) ─────────────────────────────
# Project Settings → Database → Connection string
# DATABASE_URL: transaction pooler (port 6543), add ?pgbouncer=true — used by the app
# DIRECT_URL:   direct or session connection (port 5432) — used by prisma db push, seed, scripts
DATABASE_URL=
DIRECT_URL=

# ── Tenancy ───────────────────────────────────────
# Farm shown when the host has no farm subdomain (single-farm launch on a free host).
DEFAULT_TENANT_SLUG=merryfarms
# Set once farms get their own subdomains, e.g. farmforyou.in → merryfarms.farmforyou.in
NEXT_PUBLIC_ROOT_DOMAIN=

# ── Seed ──────────────────────────────────────────
# Merry Farms' contact / WhatsApp Business number, used by npm run db:seed
SEED_FARM_PHONE=+919626043372

# ── Scheduled jobs ───────────────────────────────
# Secret for POST /api/cron/plans (creates weekly/daily plan orders each evening).
# Any free scheduler can call it with:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Phone notifications (web push, free) ─────────
# Generate once with:  node scripts/vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Customer sign-in codes (OTP) ─────────────────
# Without a provider the live site keeps personal-link sign-in; the demo shows codes on screen.
# OTP_SECRET: 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_SECRET=
# whatsapp (Meta Cloud API authentication template, ~₹0.12/code) or msg91 (SMS, DLT needed, ~₹0.15–0.25/code)
OTP_PROVIDER=
WHATSAPP_OTP_TEMPLATE=sign_in_code
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# ── FarmForYou WhatsApp Business number (Meta Cloud API) ─────────
# Used for sign-in codes (OTP_PROVIDER=whatsapp) and automatic new-order alerts to farms.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Utility template, 4 body values: order code, customer, total, items. About ₹0.12 per alert.
WHATSAPP_ALERT_TEMPLATE=new_order_alert
