// FarmForYou — Prisma schema (Merry Farms is the first farm)
// Multi-tenant farm-shop platform. Database: Supabase Postgres (free tier at launch).
// Tenant isolation: tenantId on every farm-owned model, enforced in code by
// src/lib/tenant-db.ts, plus RLS enabled with no public policies (prisma/sql/rls.sql).
// Money is stored in paise (Int). Bilingual text is stored as Ta/En column pairs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────

enum TenantStatus {
  trial
  active
  suspended
}

enum Plan {
  free
  starter
  growth
  pro
}

enum WhatsAppMode {
  lite // farm's own WhatsApp Business app + one-tap prefilled messages
  cloud // Meta WhatsApp Cloud API
}

enum Language {
  ta
  en
}

enum StaffRole {
  owner
  /// Adds farm expenses (labour, electricity…) but sees no totals, sales or profit.
  manager
  order_desk
  packing
  delivery
}

enum OrderStatus {
  to_confirm
  confirmed
  packed
  out_for_delivery
  delivered
  cancelled
}

enum OrderChannel {
  whatsapp
  web
  phone
  walk_in
}

enum PaymentMethod {
  upi_on_delivery
  cash_on_delivery
  upi_prepaid
  credit
}

enum CallOutcome {
  confirmed
  changed
  cancelled
  no_answer
  wrong_number
}

enum InvoiceType {
  tax_invoice
  bill_of_supply
  credit_note
}

enum LedgerType {
  charge // + order delivered
  payment // − money received
  adjustment // ± manual correction
  credit_note // − goods returned or short delivered
  refund // + money paid back to the customer
}

enum SubscriptionStatus {
  active
  paused
  cancelled
}

enum MessageSender {
  customer
  farm
}

enum ReturnReason {
  damaged
  short_delivered
  returned
  quality
  other
}

enum RefundMethod {
  account // reduce dues, or keep as an advance
  cash
  upi
}

enum PaymentStatus {
  received
  pending
  failed
  refunded
}

// ─────────────────────────────────────────────────
// TENANT & STAFF
// ─────────────────────────────────────────────────

model Tenant {
  id              String       @id @default(uuid())
  slug            String       @unique // subdomain, e.g. "merryfarms"
  nameTa          String
  nameEn          String
  status          TenantStatus @default(trial)
  plan            Plan         @default(free)
  /// Eggs in store: one count shared by every egg product (tray of 30, pack of 12). Each egg product's stockQty
  /// is always floor(eggStore / eggsPerUnit); see src/server/stock.ts.
  eggStore        Int          @default(0)
  trialEndsAt     DateTime?
  defaultLanguage Language     @default(ta)
  phone           String // farm contact number shown to customers
  upiId           String? // payments go straight to the farm
  gstin           String?
  fssaiNo         String?
  invoicePrefix   String       @default("INV")

  // WhatsApp
  whatsappMode          WhatsAppMode @default(lite)
  whatsappNumber        String? // number customers chat with
  whatsappPhoneNumberId String? // Cloud API only
  whatsappAccessToken   String? // Cloud API only, encrypted at rest
  whatsappWabaId        String? // Cloud API only

  // Feature switches chosen by the farm owner; see src/domain/features.ts.
  // What is actually on = plan allows it AND the farm switched it on.
  features Json @default("{}")

  // Delivery area (src/domain/delivery-area.ts): radius around the farm and/or PIN codes served.
  farmLat          Float?
  farmLng          Float?
  deliveryRadiusKm Float?
  servedPincodes   String[]

  // Delivery charges
  deliveryFeePaise Int @default(3000)
  freeAbovePaise   Int @default(50000) // 0 = never free

  // Look: the farm's logo (served by /img/logo, see TenantLogo) and the drawings it picked for its shop
  // (ids from src/components/art/drawing-library.ts; empty = chosen from its product types).
  logoUrl      String?
  shopArt      String[] @default([])
  // Brand (src/domain/brand.ts): the farm's tagline, the colours its name's words take in turn
  // (e.g. Merry red, Farms green; empty = the normal text colour), and the opening animation played when its
  // installed app opens (an id from OPENING_MARKS, set by the platform; null = the farm's logo pops in).
  taglineTa    String?
  taglineEn    String?
  nameColours  String[] @default([])
  openingMark  String?
  // The farm's app colours (src/domain/brand-theme.ts): buttons and links, and highlights such as badges.
  // null = Farm For You's colours. Adjusted automatically for readability in light, dark and soft modes.
  themePrimary String?
  themeAccent  String?

  // What the farm may use, worked out from its plan, add-ons and admin's overrides (src/domain/entitlements.ts) and
  // saved here whenever they change; null = not on an admin-made plan yet (the old `plan` level applies).
  entitlements Json?

  // Storage for the farm's uploaded videos, in MB; null = the default (DEFAULT_VIDEO_SPACE_MB). Set by the platform.
  videoSpaceMb Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription     FarmSubscription?
  platformInvoices PlatformInvoice[]
  platformPayments PlatformPayment[]
  requests         FarmRequest[]
  staff            StaffMember[]
  categories       Category[]
  products         Product[]
  slots            DeliverySlot[]
  customers        Customer[]
  orders           Order[]

  @@map("tenants")
}

// A farm's confirmation-call rules are settings in the registry now (src/domain/settings.ts: callWhatsAppOrders…).

model StaffMember {
  id         String      @id @default(uuid())
  tenantId   String
  authUserId String // Supabase auth.users id
  staffCode  String? // what staff sign in with, e.g. MER-002; null only on logins made before staff IDs
  name       String
  phone      String?
  email      String? // null for staff signing in by Staff ID alone
  roles      StaffRole[]
  language   Language    @default(ta)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tenantId, authUserId])
  @@unique([tenantId, staffCode])
  @@index([authUserId])
  @@map("staff_members")
}

/// Platform owners (FarmForYou). Not tied to a tenant.
model PlatformAdmin {
  id         String   @id @default(uuid())
  authUserId String   @unique
  name       String
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("platform_admins")
}

/// A username a super admin or farm admin (owner) can sign in with instead of their email.
/// One per login, unique across the platform, stored lowercase. Not a farm table: a login isn't one farm's.
model LoginUsername {
  username   String   @id
  authUserId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("login_usernames")
}

// ─────────────────────────────────────────────────
// CATALOGUE & DELIVERY
// ─────────────────────────────────────────────────

model Category {
  id             String    @id @default(uuid())
  tenantId       String
  nameTa         String
  nameEn         String
  sortOrder      Int       @default(0)
  showOnWhatsApp Boolean   @default(true)
  /// What it holds (egg, milk, oil, vegetables, pickles…; see domain/product-art). Picks the drawing.
  kind           String?
  deletedAt      DateTime? // removed by the farm; kept so old products and orders stay readable

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id              String    @id @default(uuid())
  tenantId        String
  categoryId      String
  nameTa          String
  nameEn          String
  packTa          String // e.g. "30 முட்டை"
  packEn          String // e.g. "Tray of 30"
  noteTa          String?
  noteEn          String?
  pricePaise      Int // GST-inclusive selling price
  offerPricePaise Int? // a lower price for a while ("₹390 → ₹360")
  offerEndsOn     String? // last IST day of the offer, "2026-10-25"; null = until removed
  stockQty        Int       @default(0)
  stockUnit       String    @default("packs")
  /// Eggs in one unit of this product (30 in a tray, 12 in a pack); set only for egg products, which then take
  /// their stock from the farm's egg store.
  eggsPerUnit     Int?
  hsn             String?
  gstRate         Int       @default(0) // percent; 0 = exempt
  imageUrl        String?
  onWeb           Boolean   @default(true)
  onWhatsApp      Boolean   @default(true)
  isActive        Boolean   @default(true)
  /// Hidden by Farm For You's screening (src/domain/compliance.ts): block | hold | licence; null = free. While set,
  /// the farm can't show the product; Farm For You allows it, keeps it hidden or removes it.
  complianceHold  String?
  sortOrder       Int       @default(0)
  deletedAt       DateTime? // soft delete keeps old orders readable
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  @@index([tenantId, categoryId])
  @@map("products")
}

model DeliverySlot {
  id          String  @id @default(uuid())
  tenantId    String
  nameTa      String
  nameEn      String
  startTime   String // "07:00", farm local time (IST)
  endTime     String // "09:00"
  daysOfWeek  Int[] // 0 = Sunday … 6 = Saturday
  cutoffHours Int     @default(12)
  maxOrders   Int     @default(20)
  isActive    Boolean @default(true)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders        Order[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([tenantId])
  @@map("delivery_slots")
}

// ─────────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────────

model Customer {
  id               String    @id @default(uuid())
  tenantId         String
  phone            String // E.164, e.g. +919000010001
  name             String
  language         Language  @default(ta)
  isTrusted        Boolean   @default(false) // owner-marked; may skip the call
  creditLimitPaise Int       @default(0) // 0 = no credit (khata)
  marketingOptIn   Boolean   @default(false)
  optInAt          DateTime?
  notes            String?
  /// The customer's private key for "My orders" and messages (no login). Kept in a cookie on
  /// their phone and in their personal link; the farm can reset it.
  accessToken      String?   @unique
  tokenIssuedAt    DateTime?
  createdAt        DateTime  @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses     Address[]
  messages      Message[]
  orders        Order[]
  ledger        LedgerEntry[]
  payments      Payment[]
  invoices      Invoice[]
  subscriptions Subscription[]
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([tenantId, phone])
  @@map("customers")
}

model Address {
  id             String   @id @default(uuid())
  tenantId       String
  customerId     String
  line           String
  landmark       String?
  pincode        String?
  lat            Float?
  lng            Float?
  /// How the location was given: "gps" (where the phone was), "map" (pin placed on the map), "link" (a maps link pasted).
  locationSource String?
  /// The place at the location, looked up when it was given: "Velachery, Chennai 600042".
  placeName      String?
  /// Delivery to someone else (e.g. ordering for parents): who receives it, and their phone.
  receiverName   String?
  receiverPhone  String?
  isDefault      Boolean  @default(true)
  createdAt      DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders    Order[]
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, customerId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────

model Order {
  id               String        @id @default(uuid())
  tenantId         String
  number           Int // per-tenant running number, shown as MF-1047
  customerId       String
  addressId        String?
  channel          OrderChannel
  status           OrderStatus   @default(to_confirm)
  slotId           String?
  slotDate         String // "2026-10-21", IST date of delivery
  slotLabel        String // copied at order time, e.g. "7–9 AM"
  paymentMethod    PaymentMethod
  subtotalPaise    Int
  deliveryFeePaise Int
  totalPaise       Int
  needsCall        Boolean       @default(true)
  cancelReason     String?
  note             String?
  deliveredAt      DateTime?
  subscriptionId   String? // set when a weekly/daily plan created this order
  areaCheck        String? // "inside" | "outside" | "unknown"; null when the farm has no area set
  distanceKm       Float? // from the farm, when the customer shared their location
  pinCheck         String? // PIN typed vs PIN at the location: "match" | "near" | "mismatch" | "unknown"; null without a location
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer           @relation(fields: [customerId], references: [id])
  address      Address?           @relation(fields: [addressId], references: [id])
  slot         DeliverySlot?      @relation(fields: [slotId], references: [id])
  items        OrderItem[]
  events       OrderEvent[]
  calls        ConfirmationCall[]
  invoices     Invoice[]
  payments     Payment[]
  returns      OrderReturn[]
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id])

  @@unique([tenantId, number])
  @@unique([subscriptionId, slotDate]) // a plan never creates two orders for the same day
  @@index([tenantId, status])
  @@index([tenantId, slotDate, slotId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid())
  tenantId       String
  orderId        String
  productId      String
  qty            Int
  unitPricePaise Int // copied at order time
  gstRate        Int // copied at order time

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, orderId])
  @@map("order_items")
}

/// Audit trail of every status change on an order.
model OrderEvent {
  id         String       @id @default(uuid())
  tenantId   String
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  byStaffId  String?
  note       String?
  at         DateTime     @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, orderId])
  @@map("order_events")
}

model ConfirmationCall {
  id          String      @id @default(uuid())
  tenantId    String
  orderId     String
  attempt     Int
  outcome     CallOutcome
  calledById  String?
  note        String?
  durationSec Int?
  at          DateTime    @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, orderId])
  @@map("confirmation_calls")
}

// ─────────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────────

/// An issued invoice never changes: everything printed on it is frozen in `snapshot`,
/// so renaming a product or changing the farm's address later cannot alter old invoices.
model Invoice {
  id          String      @id @default(uuid())
  tenantId    String
  orderId     String?
  customerId  String
  type        InvoiceType
  number      String // e.g. MF/2026-27/0001
  fy          String // "2026-27"
  seq         Int
  totalPaise  Int
  taxPaise    Int         @default(0)
  snapshot    Json // see InvoiceSnapshot in src/domain/invoices.ts
  publicToken String      @unique // unguessable; lets the customer open their invoice without login
  pdfUrl      String?
  issuedAt    DateTime    @default(now())

  /// For credit notes: the invoice they correct.
  refInvoiceId String?

  order       Order?        @relation(fields: [orderId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  refInvoice  Invoice?      @relation("CreditNotes", fields: [refInvoiceId], references: [id])
  creditNotes Invoice[]     @relation("CreditNotes")
  returns     OrderReturn[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, customerId])
  @@index([tenantId, fy, seq])
  @@map("invoices")
}

/// Next invoice sequence per tenant per financial year.
model InvoiceCounter {
  tenantId  String
  series    String   @default("INV") // "INV" for invoices, "CN" for credit notes
  fy        String
  nextSeq   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@id([tenantId, series, fy])
  @@map("invoice_counters")
}

/// Khata: a customer's balance is the sum of their entries (charges positive, payments negative).
model LedgerEntry {
  id          String     @id @default(uuid())
  tenantId    String
  customerId  String
  type        LedgerType
  amountPaise Int
  refType     String? // "order" | "payment" | "invoice"
  refId       String?
  note        String?
  at          DateTime   @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, customerId])
  @@map("ledger_entries")
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  orderId       String?
  method        PaymentMethod
  amountPaise   Int
  status        PaymentStatus @default(received)
  collectedById String?
  reference     String? // UPI reference or Razorpay id
  note          String?
  at            DateTime      @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, customerId])
  @@map("payments")
}

/// Goods returned or short delivered after an order was delivered.
/// Kept even when the farm doesn't issue invoices, so the history is always there.
model OrderReturn {
  id               String       @id @default(uuid())
  tenantId         String
  orderId          String
  /// [{ productId, qty, unitPricePaise, gstRate }] at the agreed prices
  items            Json
  reason           ReturnReason
  note             String?
  amountPaise      Int // goods + any delivery charge refunded
  deliveryFeePaise Int          @default(0)
  refundMethod     RefundMethod
  restocked        Boolean      @default(false)
  creditNoteId     String?
  byStaffId        String?
  at               DateTime     @default(now())

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creditNote Invoice? @relation(fields: [creditNoteId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([tenantId, orderId])
  @@map("order_returns")
}

/// The farm's own wording for a WhatsApp message (see src/domain/templates.ts).
/// Empty text falls back to the built-in default for that language.
model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  key       String // a TemplateKey, e.g. "confirmed"
  bodyTa    String?
  bodyEn    String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, key])
  @@map("message_templates")
}

/// A weekly or daily plan: the same order on chosen days (eggs every Sunday, milk every day).
/// Orders are created a day or two ahead; see src/server/plans.ts.
model Subscription {
  id            String             @id @default(uuid())
  tenantId      String
  customerId    String
  addressId     String?
  slotId        String
  /// [{ productId, qty }]
  items         Json
  daysOfWeek    Int[] // 0 = Sunday … 6 = Saturday
  paymentMethod PaymentMethod
  discountPct   Int                @default(0) // plan price, e.g. 5 = 5% off
  status        SubscriptionStatus @default(active)
  startDate     String // IST "YYYY-MM-DD"
  pausedUntil   String? // paused up to and including this date
  skipDates     String[] // single days the customer doesn't want
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id])
  slot     DeliverySlot @relation(fields: [slotId], references: [id])
  orders   Order[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

/// A message between a customer and the farm, inside the app (no WhatsApp needed).
/// One conversation per customer; a message can mention an order.
model Message {
  id         String        @id @default(uuid())
  tenantId   String
  customerId String
  sender     MessageSender
  body       String
  orderId    String?
  byStaffId  String? // who replied, for farm messages
  /// When the other side opened the conversation after this message (the "Seen" tick).
  seenAt     DateTime?
  createdAt  DateTime      @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, sender, seenAt])
  @@map("messages")
}

/// A phone that accepted notifications (web push), for a customer or a staff member.
model PushSubscription {
  id         String    @id @default(uuid())
  tenantId   String
  customerId String?
  staffId    String?
  endpoint   String
  p256dh     String
  auth       String
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?
  updatedAt  DateTime  @default(now()) @updatedAt

  @@unique([tenantId, endpoint])
  @@index([tenantId, customerId])
  @@index([tenantId, staffId])
  @@map("push_subscriptions")
}

/// A product's photo, shrunk on the phone before upload (~50 KB). Kept in the database so
/// the free tier needs no separate file storage; served by /img/p/<productId>.
model ProductImage {
  productId   String   @id
  tenantId    String
  mime        String
  /// Older photos kept in the database; new ones live in file storage (storagePath). See src/server/photos.ts.
  data        Bytes?
  storagePath String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("product_images")
}

/// A farm's logo, shrunk on the phone before upload. Kept in the database like product photos; served by /img/logo.
model TenantLogo {
  tenantId    String   @id
  mime        String
  /// Older logos kept in the database; new ones live in file storage (storagePath). See src/server/photos.ts.
  data        Bytes?
  storagePath String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("tenant_logos")
}

/// A sign-in code sent to a customer's mobile. Only a keyed hash of the code is kept.
model OtpCode {
  id        String    @id @default(uuid())
  tenantId  String
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([tenantId, phone, createdAt])
  @@map("otp_codes")
}

/// A day (or one slot on a day) with no deliveries: festival, family event, rest day.
model ClosedDay {
  id        String   @id @default(uuid())
  tenantId  String
  date      String // IST "2026-01-15"
  slotId    String? // null = the whole day
  note      String? // shown to customers, e.g. "Pongal"
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, date])
  @@map("closed_days")
}

/// A batch of birds (or other animals) that came onto the farm together: bought in, or hatched here.
/// Its birds alive are never typed: chicks at the start minus everything lost, sold or given (see src/domain/batches.ts).
model Batch {
  id             String   @id @default(uuid())
  tenantId       String
  number         Int // Batch 1, 2, 3… per farm
  name           String
  breed          String? // e.g. நாட்டுக்கோழி, Aseel
  purpose        String // eggs | meat | breeding
  source         String // bought | hatched
  supplier       String?
  startDate      String // IST: first day on the farm (for hatched: the hatch day)
  ageAtStartDays Int      @default(0) // age when it came; 0 when hatched here
  startCount     Int // chicks on the first day
  eggsSet        Int? // hatched here: eggs put to hatch
  parentBatchId  String? // hatched here: the batch whose eggs they were
  eggValuePaise  Int? // what one egg from this batch is worth, to value eggs in its profit
  closedDate     String? // IST: the batch is finished (all sold or gone)
  note           String?
  createdAt      DateTime @default(now())

  days         BatchDay[]
  losses       BatchLoss[]
  vaccinations BatchVaccination[]
  weights      BatchWeight[]
  updatedAt    DateTime           @default(now()) @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, closedDate])
  @@map("batches")
}

/// One day of one batch: feed, eggs, birds sold or given. Losses for the day are BatchLoss rows.
model BatchDay {
  id            String   @id @default(uuid())
  tenantId      String
  batchId       String
  date          String // IST
  feedKg        Float?
  eggsCollected Int?
  eggsBroken    Int?
  sold          Int      @default(0) // birds sold
  soldPaise     Int      @default(0) // money for those birds
  given         Int      @default(0) // used at home or given away
  note          String?
  byStaffId     String?
  updatedAt     DateTime @updatedAt

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([batchId, date])
  @@index([tenantId, date])
  @@map("batch_days")
}

/// Birds lost from a batch on a day, by cause (one row per cause), so losses can be counted and priced.
model BatchLoss {
  id       String @id @default(uuid())
  tenantId String
  batchId  String
  date     String // IST
  cause    String // disease | predator | heat | weak | injury | unknown | culled
  count    Int

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([batchId, date])
  @@index([tenantId, date])
  @@map("batch_losses")
}

/// The farm's own vaccine plan, by age in days. Each new batch gets a copy of the doses still ahead of it.
model VaccineScheduleItem {
  id        String   @id @default(uuid())
  tenantId  String
  vaccine   String // e.g. Lasota, Gumboro, as the farm or its vet calls it
  ageDays   Int // give at this age
  method    String? // see VACCINE_METHODS in src/domain/vaccinations.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([tenantId, ageDays])
  @@map("vaccine_schedule")
}

/// One dose for a batch: planned (dueDate, not yet given) and/or given (givenDate).
/// A given dose with a cost has a "medicine" expense on the batch (expenseId), so it counts in profit.
model BatchVaccination {
  id        String   @id @default(uuid())
  tenantId  String
  batchId   String
  vaccine   String
  method    String?
  dueDate   String? // IST: planned day (hatch day + age)
  givenDate String? // IST: day it was given; null while planned
  birds     Int? // birds given the dose
  expenseId String?
  note      String?
  byStaffId String?
  createdAt DateTime @default(now())

  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([batchId])
  @@index([tenantId, givenDate, dueDate])
  @@map("batch_vaccinations")
}

/// The farm's videos for the shop: clips uploaded from the farm app (kept in Supabase storage, bucket "farm-media")
/// or YouTube links. banner: plays silently on repeat on the shop's home page (uploads only); watch: in
/// "Watch our farm", plays with sound when tapped. See src/domain/videos.ts.
model FarmVideo {
  id          String   @id @default(uuid())
  tenantId    String
  kind        String // upload | youtube
  src         String // public file address (upload) or YouTube video id
  storagePath String? // the file in storage, to remove it with the video
  posterPath  String?
  posterUrl   String?
  title       String?
  banner      Boolean  @default(false)
  watch       Boolean  @default(true)
  sortOrder   Int      @default(0)
  seconds     Int?
  bytes       Int?
  byStaffId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId, sortOrder])
  @@map("farm_videos")
}

/// A weighing: a few birds of a batch weighed on a day (usually once a week), to follow growth.
/// The average is totalGrams / birds; one weighing per batch per day (saving again replaces it).
model BatchWeight {
  id         String   @id @default(uuid())
  tenantId   String
  batchId    String
  date       String // IST
  birds      Int // how many birds were weighed
  totalGrams Int // their weight together
  note       String?
  byStaffId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, date])
  @@index([tenantId, date])
  @@map("batch_weights")
}

/// Money spent running the farm (feed, medicine, chicks, labour…), for profit.
/// batchId: spent on one batch (chicks, medicine). quantityKg: feed bought, which fills the feed store.
/// spreadMonths: see src/domain/records.ts costInPeriod.
model Expense {
  id           String   @id @default(uuid())
  tenantId     String
  date         String // IST
  kind         String // see EXPENSE_KINDS in src/domain/records.ts
  amountPaise  Int
  quantityKg   Float?
  batchId      String?
  /// What it was spent on (Farm Core cost centres): a place (plot, shed, pond, well) or an asset (motor, tractor),
  /// whose repair and running costs it then shows; neither = the whole farm (common costs).
  placeId      String?
  assetId      String?
  /// A big cost (building, equipment) shared out over this many months in profit; null = counted on the day paid.
  spreadMonths Int?
  note         String?
  byStaffId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([tenantId, date])
  @@index([batchId])
  @@index([placeId])
  @@index([assetId])
  @@map("expenses")
}

/// How much of a product the farm made or collected on a day (bottles of oil, litres of
/// milk, packs of eggs), and how much spoiled. Good quantity can go into stock.
model ProductionEntry {
  id        String   @id @default(uuid())
  tenantId  String
  date      String // IST
  productId String
  made      Float // in the product's own unit (stockUnit)
  wasted    Float    @default(0)
  byStaffId String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([tenantId, date, productId])
  @@map("production_entries")
}

/// A super admin working inside one farm's app to fix something ("support mode"). Started from FarmForYou admin
/// with a reason; ends on Exit or after an hour. The farm admin sees every visit and what changed.
/// See src/server/support.ts.
model SupportVisit {
  id              String    @id @default(uuid())
  tenantId        String
  adminId         String // platform_admins.id
  adminAuthUserId String
  adminName       String
  reason          String
  endsAt          DateTime
  endedAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([tenantId, createdAt])
  @@map("support_visits")
}

/// One change made during a support visit: which kind of record, and whether it was added, changed or removed.
model SupportChange {
  id        String   @id @default(uuid())
  tenantId  String
  visitId   String
  model     String // e.g. Order, Product, Tenant
  operation String // create | update | delete (and their *Many forms)
  recordId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([visitId])
  @@index([tenantId, createdAt])
  @@map("support_changes")
}

// ─────────────────────────────────────────────────
// PLATFORM: PLANS, SUBSCRIPTIONS, MODULES, REQUESTS (docs/platform-plan.md §3.5)
// ─────────────────────────────────────────────────

/// A plan the platform admin makes from modules: what goes in it is not fixed in code. Editing a plan farms already
/// use makes a new version (same family); farms stay on theirs until admin moves them. See src/server/subscriptions.ts.
model PlatformPlan {
  id            String   @id @default(uuid())
  /// Versions of one plan share a family; the newest one is offered to farms.
  family        String
  version       Int      @default(1)
  nameTa        String
  nameEn        String
  descriptionTa String?
  descriptionEn String?
  monthlyPaise  Int      @default(0)
  yearlyPaise   Int?
  trialDays     Int      @default(30)
  /// Module keys (src/domain/modules.ts); Farm Core is always included.
  modules       String[]
  /// { featureKey: "on" | "off" }: features the plan fixes; missing = the farm's choice.
  features      Json     @default("{}")
  /// { products, staff, ordersPerMonth, videoSpaceMb }: missing = no limit.
  limits        Json     @default("{}")
  /// Shown to farms on the price list and the home page; private plans are made for one farm.
  isPublic      Boolean  @default(true)
  /// Retired versions stay for the farms on them but aren't offered.
  retired       Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions FarmSubscription[]

  @@unique([family, version])
  @@map("platform_plans")
}

/// A farm's subscription: one plan plus add-on modules. Its effect is saved on the farm as tenants.entitlements.
model FarmSubscription {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  planId             String
  /// trial | active | past_due | paused | ended (src/domain/entitlements.ts)
  status             String    @default("trial")
  /// monthly | yearly
  billingCycle       String    @default("monthly")
  startedAt          DateTime  @default(now())
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime?
  /// Extra modules on top of the plan
  addOns             String[]  @default([])
  /// { moduleKey: true | false }: admin's per-farm additions or removals
  moduleOverrides    Json      @default("{}")
  /// A special price for this farm (paise a billing cycle); null = the plan's
  priceOverridePaise Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   PlatformPlan @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("farm_subscriptions")
}

/// A module as the platform offers it: switched on or off for every farm, and its price as an add-on.
model ModuleSetting {
  moduleKey         String   @id
  enabled           Boolean  @default(true)
  addOnMonthlyPaise Int?
  addOnYearlyPaise  Int?
  addOnTrialDays    Int      @default(14)
  /// Farms can ask for it as an add-on (else only admin adds it)
  requestable       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("module_settings")
}

/// Something a farm asks the platform for: an add-on module or a change of plan. Admin approves or declines.
model FarmRequest {
  id        String    @id @default(uuid())
  tenantId  String
  /// add_on | plan_change
  kind      String
  moduleKey String?
  planId    String?
  /// pending | approved | declined | withdrawn
  status    String    @default("pending")
  note      String?
  /// Admin's reply, shown to the farm
  reply     String?
  byStaffId String?
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("farm_requests")
}

// ─────────────────────────────────────────────────
// AUTOMATION: EVENTS, JOBS, RECIPE SETTINGS (docs/platform-plan.md §5; src/server/automation.ts)
// ─────────────────────────────────────────────────

/// Something that happened (order.placed, request.created, subscription.changed…): the activity log and what rules react to.
model PlatformEvent {
  id        String   @id @default(uuid())
  /// null = about the platform itself
  tenantId  String?
  type      String
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("platform_events")
}

/// Work to do later or on a schedule, with retries. Every tick is recorded here too (type "tick"), so admin can see
/// the engine running.
model Job {
  id         String    @id @default(uuid())
  type       String
  tenantId   String?
  payload    Json      @default("{}")
  runAt      DateTime  @default(now())
  /// pending | running | done | failed
  status     String    @default("pending")
  attempts   Int       @default(0)
  lastError  String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAt])
  @@index([type, createdAt])
  @@map("jobs")
}

// A recipe's switch and numbers are settings in the registry (setting_values below).

/// An alert a recipe has sent, so it is sent once (e.g. order X turned red; product Y low on this day).
model AutomationNotice {
  id         String   @id @default(uuid())
  tenantId   String
  recipe     String
  subjectKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, recipe, subjectKey])
  @@map("automation_notices")
}

// ─────────────────────────────────────────────────
// SETTINGS REGISTRY AND AUDIT LOG (docs/platform-plan.md §4; src/domain/settings.ts, src/server/settings.ts)
// ─────────────────────────────────────────────────

/// One saved setting value. scopeKey says whose: "platform" (Farm For You's value for every farm), "farm:<tenantId>"
/// or "staff:<id>" / "customer:<id>" (one person's own). A setting nobody saved takes its default from the registry.
model SettingValue {
  id        String   @id @default(uuid())
  scopeKey  String
  /// The farm it belongs to (null for Farm For You's values)
  tenantId  String?
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scopeKey, key])
  @@index([tenantId])
  @@map("setting_values")
}

/// Farm For You's controls on one setting: lock it (every farm gets the platform value), hide it from farms, or
/// offer it only to chosen farms first. No row = none of these.
model SettingControl {
  key       String   @id
  locked    Boolean  @default(false)
  hidden    Boolean  @default(false)
  onlyFarms String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("setting_controls")
}

/// Who changed what, when, from what to what: settings, switches and (later) plans, payments and admin work.
model AuditEntry {
  id         String   @id @default(uuid())
  /// The farm it is about (null = about the platform itself)
  tenantId   String?
  /// platform_admin | staff | customer | system
  actorKind  String
  actorId    String?
  actorName  String?
  /// Made by Farm For You support inside the farm's app
  viaSupport Boolean  @default(false)
  /// e.g. setting.changed, setting.control, feature.switched
  action     String
  /// What it was done to (a setting's key, a feature's key…)
  subject    String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}

// ─────────────────────────────────────────────────
// PLATFORM BILLING AND ANNOUNCEMENTS (docs/platform-plan.md §3.5, §3.6; src/server/platform-billing.ts)
// Farm For You's own billing details and GST switch are one saved value: setting_values, scope "platform",
// key "billing.profile" (src/domain/platform-billing.ts).
// ─────────────────────────────────────────────────

/// Farm For You's invoice to a farm (its plan fee and add-ons). The lines, Farm For You's details and the farm's are
/// copied in when it is made, so a sent invoice never changes. Paid when its payments reach the total.
model PlatformInvoice {
  id            String    @id @default(uuid())
  /// e.g. FFY/26-27/0001: numbered per Indian financial year (April to March)
  number        String    @unique
  tenantId      String
  periodStart   String?
  periodEnd     String?
  /// [{ text, amountPaise }]
  lines         Json
  subtotalPaise Int
  /// 0 while GST is switched off
  gstRatePct    Int       @default(0)
  /// cgst_sgst (same state) | igst (another state) | none
  gstKind       String    @default("none")
  gstPaise      Int       @default(0)
  totalPaise    Int
  /// due | paid | void
  status        String    @default("due")
  issuedOn      String
  dueOn         String
  /// Farm For You's details when it was made (name, address, GSTIN, SAC, UPI, bank)
  seller        Json
  /// The farm's details when it was made (name, phone, GSTIN)
  buyer         Json
  notes         String?
  voidReason    String?
  createdBy     String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments PlatformPayment[]

  @@index([tenantId, issuedOn])
  @@index([status, dueOn])
  @@map("platform_invoices")
}

/// Money a farm paid Farm For You (UPI or bank for now), against one invoice.
model PlatformPayment {
  id          String   @id @default(uuid())
  tenantId    String
  invoiceId   String
  amountPaise Int
  /// upi | bank | cash | other
  method      String
  /// UPI or bank reference
  reference   String?
  paidOn      String
  notes       String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice PlatformInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([tenantId, paidOn])
  @@map("platform_payments")
}

/// A note from Farm For You shown on farms' Today page between its dates: to every farm or chosen ones, to owners
/// or all staff.
model Announcement {
  id        String   @id @default(uuid())
  titleTa   String
  titleEn   String
  bodyTa    String?
  bodyEn    String?
  /// info | important
  tone      String   @default("info")
  /// owners | everyone
  audience  String   @default("owners")
  /// Empty = every farm
  onlyFarms String[] @default([])
  startsOn  String
  /// null = until ended
  endsOn    String?
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsOn])
  @@map("announcements")
}

// ─────────────────────────────────────────────────
// JOINING: FARMS THAT REGISTER THEMSELVES (docs/platform-plan.md §3.8; src/server/applications.ts)
// ─────────────────────────────────────────────────

/// A farm asking to join from the home page. Not a farm yet: the Farm For You team reviews it, and on approval adds
/// the farm (and its owner's login) from it, as when admin adds one.
model FarmApplication {
  id               String    @id @default(uuid())
  /// Short number told to the farm: "FFY-J0007"
  number           Int       @unique
  ownerName        String
  /// +91XXXXXXXXXX
  phone            String
  email            String
  nameTa           String
  nameEn           String?
  /// Module keys the farm is interested in (src/domain/modules.ts)
  modules          String[]  @default([])
  district         String
  address          String
  pincode          String
  lat              Float?
  lng              Float?
  fssai            String?
  gstin            String?
  pan              String?
  /// The public plan the farm liked, if any
  planId           String?
  message          String?
  language         String    @default("ta")
  /// The seller agreement and prohibited items policy, as accepted
  agreementVersion String
  agreedAt         DateTime
  /// applied | reviewing | needs_info | on_hold | approved | rejected
  status           String    @default("applied")
  /// { phone: true, location: true, documents: true, call: true, visit: true }: what the reviewer has checked
  checklist        Json      @default("{}")
  /// The team's own notes (never shown to the farm)
  notes            String?
  /// What the farm was told: details still needed, or why it was turned down
  reply            String?
  reviewedBy       String?
  decidedAt        DateTime?
  /// The farm made from it, once approved
  tenantId         String?
  /// A one-way hash of where it was sent from, to stop floods
  sourceHash       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([phone])
  @@index([sourceHash, createdAt])
  @@map("farm_applications")
}

// ─────────────────────────────────────────────────
// ITEMS AGAINST THE LAW: SCREENING AND CASES (docs/platform-plan.md §3.9; src/server/compliance.ts)
// ─────────────────────────────────────────────────

/// One entry of the restricted items list, edited in admin: the words that find it and what a match does.
model RestrictedItem {
  id        String   @id @default(uuid())
  labelTa   String
  labelEn   String
  wordsTa   String[] @default([])
  wordsEn   String[] @default([])
  /// block | hold | licence
  action    String
  /// Told to the farm when its product is hidden
  reasonTa  String
  reasonEn  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("restricted_items")
}

/// Something a farm listed that matched the restricted items list, waiting for or decided by Farm For You.
model ComplianceCase {
  id          String    @id @default(uuid())
  tenantId    String
  /// product | category
  kind        String
  subjectId   String
  /// The names as they were when it matched
  subjectName String
  /// The word that matched, and the list entry
  matched     String
  itemId      String?
  /// block | hold | licence
  action      String
  /// open | allowed | kept_hidden | removed | cleared
  status      String    @default("open")
  /// Whether the farm had the product showing, to put back when allowed
  wasActive   Boolean   @default(false)
  /// Farm For You's note on the decision
  note        String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([subjectId])
  @@map("compliance_cases")
}

// ─────────────────────────────────────────────────
// FARM CORE: PLACES AND ASSETS (docs/platform-plan.md §3.2; src/server/farm-core.ts)
// ─────────────────────────────────────────────────

/// A part of the farm: land (a block, or a plot inside one), a shed, a pond, a well or borewell, a store.
/// Spending can be put on it (expenses.placeId); modules later hang their work on it (crops on a plot, fish in a pond).
model FarmPlace {
  id        String    @id @default(uuid())
  tenantId  String
  /// block | plot | shed | pond | well | borewell | store | other (src/domain/farm-core.ts)
  kind      String
  name      String
  /// A plot inside a block
  parentId  String?
  /// Size, in areaUnit (land, ponds) — acre | cent | hectare | sqft
  area      Float?
  areaUnit  String    @default("acre")
  surveyNo  String?
  /// red | black | sandy | clay | loam | laterite (land)
  soil      String?
  /// Depth in feet (wells and borewells)
  depthFt   Float?
  notes     String?
  /// No longer used; kept so old records stay readable
  retiredAt DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@map("farm_places")
}

/// Something the farm owns and keeps running: a motor, pump, tractor, vehicle, generator, solar panels, a tool.
/// Its repairs and running costs are expenses with assetId; a service due date reminds the farm.
model FarmAsset {
  id               String    @id @default(uuid())
  tenantId         String
  /// motor | pump | tractor | vehicle | generator | solar | sprayer | tool | building | other
  kind             String
  name             String
  /// Where it is
  placeId          String?
  boughtOn         String?
  costPaise        Int?
  /// Service every so many days; null = no regular service
  serviceEveryDays Int?
  lastServiceOn    String?
  notes            String?
  retiredAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@map("farm_assets")
}
